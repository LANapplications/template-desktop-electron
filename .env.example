# URL del backend (template-back-express-mongo)
API_URL=http://localhost:4000

# --- Auth0 (aplicación tipo "Native") ---
# Mismo tenant y mismo AUTH0_AUDIENCE que usa el backend.
AUTH0_DOMAIN=tu-tenant.us.auth0.com
AUTH0_CLIENT_ID=tu-client-id-de-la-app-native
AUTH0_AUDIENCE=https://api.tu-app.com

# Scope: "offline_access" es lo que habilita el refresh token (sesión persistente).
# Se deja así como está
AUTH0_SCOPE=openid profile email offline_access

# prompt del login. "login" fuerza siempre la pantalla de login de Auth0, para
# poder entrar o registrarse con cualquier cuenta (en vez de reusar la última
# sesión y saltar directo al consentimiento). Dejalo vacío (AUTH0_PROMPT=) si
# preferís que reuse la sesión y entre directo.
AUTH0_PROMPT=login

# URL loopback donde la app escucha el redirect del navegador del sistema. El
# login se abre en el navegador (para reusar las sesiones de Google del usuario)
# y vuelve a este puerto. Tiene que tener puerto y estar registrada tal cual en
# "Allowed Callback URLs" de la app en Auth0.
AUTH0_CALLBACK_URL=http://127.0.0.1:41730/callback
